            <TabItem Header="Diagnostico" Visibility="Collapsed" Name="WPFTab8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Stretch" Padding="12" Margin="6">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Name="WPFDiagRefresh" Content="Atualizar diagnóstico" Margin="5" Height="{DynamicResource ButtonHeight}" ToolTip="Coleta o perfil do sistema de novo e reavalia as recomendações."/>
                            <Button Name="WPFDiagWUDrivers" Content="Buscar drivers no Windows Update" Margin="5" Height="{DynamicResource ButtonHeight}" ToolTip="Pergunta ao Windows Update quais drivers ele tem para este computador (pode levar até um minuto)."/>
                            <Button Name="WPFDiagExport" Content="Exportar relatório HTML" Margin="5" Height="{DynamicResource ButtonHeight}" ToolTip="Gera um relatório HTML com tudo desta aba e abre no navegador."/>
                            <Button Name="WPFDiagSelectRecommended" Content="Marcar todos" Margin="5" Height="{DynamicResource ButtonHeight}" ToolTip="Marca todos os itens da lista de recomendações abaixo (e as caixas correspondentes nas abas Ajustes, Jogos e Servidor)."/>
                            <Button Name="WPFDiagClearRecommended" Content="Desmarcar todos" Margin="5" Height="{DynamicResource ButtonHeight}" ToolTip="Desmarca todos os itens da lista de recomendações abaixo (e as caixas correspondentes nas abas Ajustes, Jogos e Servidor)."/>
                            <Button Name="WPFDiagApplySelected" Content="Aplicar marcados" Margin="5" Height="{DynamicResource ButtonHeight}" ToolTip="Aplica os itens marcados, igual ao botão da aba Ajustes; pode pedir ponto de restauração."/>
                            <Button Name="WPFDiagUndoSelected" Content="Desfazer marcados" Margin="5" Height="{DynamicResource ButtonHeight}" ToolTip="Desfaz os itens marcados, igual ao botão 'Desfazer' da aba Ajustes."/>
                            <TextBlock Name="WPFDiagRecCount" Text="0 de 0 recomendados marcados" Margin="10,5,5,5" VerticalAlignment="Center"
                                       FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource LabelboxForegroundColor}"/>
                        </WrapPanel>
                    </Border>

                    <ScrollViewer Name="WPFDiagScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="{DynamicResource TabContentMargin}">
                        <StackPanel Background="Transparent" Margin="5">
                            <TextBlock Name="WPFDiagStatus" Text="Coletando informações do sistema..." TextWrapping="Wrap" Margin="5,0,5,5"
                                       FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource MainForegroundColor}"/>

                            <WrapPanel Name="WPFDiagCards" Orientation="Horizontal" HorizontalAlignment="Left"/>

                            <TextBlock Name="WPFDiagInfos" Text="" TextWrapping="Wrap" Margin="10,10,5,0" Visibility="Collapsed"
                                       FontSize="{DynamicResource FontSize}" Foreground="{DynamicResource MainForegroundColor}"/>

                            <TextBlock Text="Recomendações para este computador" Margin="10,15,5,5"
                                       FontSize="{DynamicResource HeaderFontSize}" FontFamily="{DynamicResource HeaderFontFamily}" Foreground="{DynamicResource LabelboxForegroundColor}"/>
                            <ItemsControl Name="WPFDiagRecs" Margin="10,0,5,0"/>

                            <TextBlock Text="Drivers instalados" Margin="10,15,5,5"
                                       FontSize="{DynamicResource HeaderFontSize}" FontFamily="{DynamicResource HeaderFontFamily}" Foreground="{DynamicResource LabelboxForegroundColor}"/>
                            <DataGrid Name="WPFDiagDrivers" Margin="10,0,5,0" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" HorizontalAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      Background="{DynamicResource CardBackgroundColor}"
                                      Foreground="{DynamicResource MainForegroundColor}" BorderBrush="{DynamicResource BorderColor}"
                                      HorizontalGridLinesBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                      FontSize="{DynamicResource FontSize}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Dispositivo" Binding="{Binding Device}" Width="*" MinWidth="180" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Classe" Binding="{Binding Class}" Width="Auto" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="Auto" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="Auto" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Fornecedor" Binding="{Binding Provider}" Width="Auto" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="Auto">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource WFGridCellText}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="atualizar">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerColor}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="verificar">
                                                        <Setter Property="Foreground" Value="{DynamicResource DiscouragedColor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="Ação" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="{Binding ActionLabel}" Tag="{Binding}" Visibility="{Binding ActionVisible}" ToolTip="{Binding ActionTip}"
                                                        IsEnabled="{Binding ActionEnabled}" ToolTipService.ShowOnDisabled="True"
                                                        Margin="8,4" Padding="10,0" MinWidth="150" Height="22" MinHeight="0" HorizontalAlignment="Left"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Name="WPFDiagWULabel" Text="Drivers oferecidos pelo Windows Update" Margin="10,15,5,5" Visibility="Collapsed"
                                       FontSize="{DynamicResource HeaderFontSize}" FontFamily="{DynamicResource HeaderFontFamily}" Foreground="{DynamicResource LabelboxForegroundColor}"/>
                            <DataGrid Name="WPFDiagWU" Margin="10,0,5,10" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Visibility="Collapsed"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single" HorizontalAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      Background="{DynamicResource CardBackgroundColor}"
                                      Foreground="{DynamicResource MainForegroundColor}" BorderBrush="{DynamicResource BorderColor}"
                                      HorizontalGridLinesBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                      RowStyle="{StaticResource WFWindowsUpdateRow}"
                                      FontSize="{DynamicResource FontSize}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Atualização" Binding="{Binding Title}" Width="*" MinWidth="180" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Driver" Binding="{Binding Driver}" Width="Auto" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Fornecedor" Binding="{Binding Provider}" Width="Auto" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Versão" Binding="{Binding Version}" Width="Auto" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Data" Binding="{Binding Date}" Width="Auto" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTextColumn Header="Situação" Binding="{Binding StatusText}" Width="Auto" ElementStyle="{StaticResource WFGridCellText}"/>
                                    <DataGridTemplateColumn Header="Instalar" Width="Auto">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Instalar" Tag="{Binding}" ToolTip="{Binding ActionTip}"
                                                        IsEnabled="{Binding ActionEnabled}" ToolTipService.ShowOnDisabled="True"
                                                        Margin="8,4" Padding="10,0" MinWidth="100" Height="22" MinHeight="0" HorizontalAlignment="Left"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
