            <TabItem Header="Jogos" Visibility="Collapsed" Name="WPFTab7">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="0" Margin="{DynamicResource TabContentMargin}">
                        <Grid Background="Transparent">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Background="{DynamicResource MainBackgroundColor}" Orientation="Vertical" Grid.Row="0" Grid.Column="0" Margin="5">
                                <Label Content="Seleções recomendadas (WinForge):" FontSize="{DynamicResource FontSize}" VerticalAlignment="Center" Margin="2"/>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,2,0,0">
                                    <Button Name="WPFPresetGamer" Content=" Gamer " Margin="2" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}" ToolTip="Marca o conjunto WinForge + otimizações de jogos (GameDVR, MMCSS, prioridade de primeiro plano, telemetria da GPU). Não marca serviços Xbox nem itens 'CUIDADO'."/>
                                    <Button Name="WPFClearGamesSelection" Content=" Limpar seleção " Margin="2" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}" ToolTip="Desmarca todos os tweaks (desta aba e da aba Tweaks)."/>
                                    <Button Name="WPFGetInstalledGames" Content=" Detectar aplicados " Margin="2" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}" ToolTip="Marca o que já está aplicado no sistema (lê o registro e os serviços)."/>
                                </WrapPanel>
                            </StackPanel>

                            <Grid Name="gamespanel" Grid.Row="1">
                            </Grid>

                            <Border Grid.Row="2" Style="{StaticResource BorderStyle}" Margin="5,15,5,5">
                                <StackPanel Background="{DynamicResource MainBackgroundColor}" Orientation="Horizontal" HorizontalAlignment="Left">
                                    <TextBlock Padding="10" TextWrapping="Wrap" Foreground="{DynamicResource MainForegroundColor}">
                                        Esquerda: prioridade de CPU Alta por jogo (IFEO). Direita: otimizações gerais para jogos e por fabricante de GPU (só aparece a GPU detectada).
                                        <LineBreak/>Passe o mouse sobre cada item para ver a descrição, o que ele altera e de qual script do Windows Boost veio.
                                        <LineBreak/>'Aplicar selecionados' aplica tudo que estiver marcado nesta aba E na aba Tweaks. 'Desfazer selecionados' reverte os itens marcados.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="1" Background="{DynamicResource MainBackgroundColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="5" HorizontalAlignment="Stretch" Padding="10">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button Name="WPFGamesApplyButton" Content="Aplicar selecionados" Margin="5" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}"/>
                            <Button Name="WPFGamesUndoButton" Content="Desfazer selecionados" Margin="5" Width="{DynamicResource ButtonWidth}" Height="{DynamicResource ButtonHeight}"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </TabItem>
